# Painel em app.abianchitech.com/saas/barbearia/painel: rotas do Angular vão para o index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /saas/barbearia/painel/

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>

# Cache: o index.html é sempre conferido com o servidor (senão o navegador abre a versão antiga do painel
# depois de uma atualização). Os .js e .css têm o código da versão no nome e podem ficar guardados por 1 ano.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
